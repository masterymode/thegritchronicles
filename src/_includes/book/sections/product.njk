<section class="product" id="product">
  <h2 class="section-title">Get the Book Today</h2>

  <div class="product__grid">
    <div class="product-card">
      <div class="product-card__image">
        <img src="/assets/book/images/product-ebook.webp" alt="The Grit Chronicles eBook" loading="lazy">
      </div>
      <div class="product-card__label">eBook</div>
      <div class="product-card__price-row">
        <span class="product-card__price-current">$14.99</span>
        <span class="product-card__price-was">$19.99</span>
      </div>
      <ul class="product-card__features">
        <li>Digital version</li>
        <li>Read on any device</li>
      </ul>
      <a href="{{ book.checkout.ebook }}" class="cta-button" data-track="buy_click" data-product="ebook" data-checkout-link>Get eBook</a>
      {% include "book/partials/payment-badges.njk" %}
    </div>

    <div class="product-card product-card--featured">
      <div class="product-card__badge">Most Popular</div>
      <div class="product-card__image">
        <img src="/assets/book/images/product-paperback.webp" alt="The Grit Chronicles paperback" loading="lazy">
      </div>
      <div class="product-card__label">Paperback</div>
      <div class="product-card__price-row">
        <span class="product-card__price-current">$28.99</span>
        <span class="product-card__price-was">$35.99</span>
      </div>
      <ul class="product-card__features">
        <li>Paperback perfect bound</li>
        <li>Worldwide shipping</li>
      </ul>
      <a href="{{ book.checkout.paperback }}" class="cta-button" data-track="buy_click" data-product="paperback" data-checkout-link>Get Paperback</a>
      {% include "book/partials/payment-badges.njk" %}
    </div>
  </div>

  <div class="product__reveal">
    <p data-reveal>Your excuses have already cost you far more than this ever will.</p>
  </div>
</section>
