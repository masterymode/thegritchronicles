<section class="ultimatum" id="ultimatum">
  <div class="ultimatum__image-wrap">
    <img src="/assets/book/images/ultimatum.webp" alt="The Choice is Yours" class="ultimatum__image" loading="lazy">
  </div>

  <h2 class="section-title">The Choice is Yours</h2>
