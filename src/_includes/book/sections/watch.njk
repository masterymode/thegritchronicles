<section class="watch" id="watch">
  <h2 class="section-title">Watch this</h2>

  <div class="video-container" id="videoContainer">
    <style>
      wistia-player[media-id='70fk1y91al']:not(:defined) {
        background: center / contain no-repeat url('https://fast.wistia.com/embed/medias/70fk1y91al/swatch');
        display: block;
        filter: blur(5px);
        padding-top: 56.25%;
      }
    </style>
    <wistia-player media-id="70fk1y91al" aspect="1.7777777777777777"></wistia-player>
  </div>
</section>

{% set videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": book.title + " — Watch this",
  "description": book.description,
  "thumbnailUrl": ["https://fast.wistia.com/embed/medias/70fk1y91al/swatch"],
  "embedUrl": "https://fast.wistia.net/embed/iframe/70fk1y91al"
} %}
<script type="application/ld+json">{{ videoSchema | dump | safe }}</script>
